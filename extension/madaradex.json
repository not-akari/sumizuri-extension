{
  "name": "MadaraDex",
  "lang": "en",
  "baseUrl": "https://madaradex.org",
  "iconUrl": "https://madaradex.org/wp-content/uploads/cropped-logo.png",
  "rateLimitMs": 1000,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Referer": "https://madaradex.org/"
  },
  "popular": {
    "url": "{baseUrl}/all/page/{page}/?m_orderby=views",
    "itemSelector": "div.page-item-detail.manga, div.page-item-detail",
    "fields": {
      "url": {
        "selector": ".post-title a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": ".post-title a",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "img",
            "attr": "data-src"
          },
          {
            "selector": "img",
            "attr": "src"
          }
        ],
        "transform": "trim",
        "resolve": true
      },
      "rating": {
        "selector": ".score",
        "attr": "text",
        "transform": "number",
        "round": 1
      }
    }
  },
  "latest": {
    "url": "{baseUrl}/all/page/{page}/?m_orderby=latest",
    "itemSelector": "div.page-item-detail.manga, div.page-item-detail",
    "fields": {
      "url": {
        "selector": ".post-title a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": ".post-title a",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "img",
            "attr": "data-src"
          },
          {
            "selector": "img",
            "attr": "src"
          }
        ],
        "transform": "trim",
        "resolve": true
      },
      "rating": {
        "selector": ".score",
        "attr": "text",
        "transform": "number",
        "round": 1
      }
    }
  },
  "search": {
    "url": "{baseUrl}/page/{page}/?s={query}&post_type=wp-manga",
    "itemSelector": "div.c-tabs-item__content, div.page-item-detail.manga, div.page-item-detail",
    "fields": {
      "url": {
        "selector": ".post-title a, h3.h4 a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": ".post-title a, h3.h4 a",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "img",
            "attr": "data-src"
          },
          {
            "selector": "img",
            "attr": "src"
          }
        ],
        "transform": "trim",
        "resolve": true
      },
      "rating": {
        "selector": ".score",
        "attr": "text",
        "transform": "number",
        "round": 1
      }
    },
    "upgrade": {
      "url": "{baseUrl}/page/{page}/?s={queryPlus}&post_type=wp-manga{order}{status}{genre}"
    }
  },
  "filters": [
    {
      "key": "order",
      "name": "Sort by",
      "type": "select",
      "options": [
        {
          "label": "Relevance",
          "value": ""
        },
        {
          "label": "Latest update",
          "value": "&m_orderby=latest"
        },
        {
          "label": "Most views",
          "value": "&m_orderby=views"
        },
        {
          "label": "Trending",
          "value": "&m_orderby=trending"
        },
        {
          "label": "Rating",
          "value": "&m_orderby=rating"
        },
        {
          "label": "New",
          "value": "&m_orderby=new-manga"
        },
        {
          "label": "A to Z",
          "value": "&m_orderby=alphabet"
        }
      ]
    },
    {
      "key": "status",
      "name": "Status",
      "type": "select",
      "options": [
        {
          "label": "Any",
          "value": ""
        },
        {
          "label": "Ongoing",
          "value": "&status%5B%5D=on-going"
        },
        {
          "label": "Completed",
          "value": "&status%5B%5D=end"
        },
        {
          "label": "Canceled",
          "value": "&status%5B%5D=canceled"
        },
        {
          "label": "On Hold",
          "value": "&status%5B%5D=on-hold"
        },
        {
          "label": "Upcoming",
          "value": "&status%5B%5D=upcoming"
        }
      ]
    },
    {
      "key": "genre",
      "name": "Genres",
      "type": "multiSelect",
      "join": "",
      "options": [
        {
          "label": "Adventure",
          "value": "&genre%5B%5D=adventure"
        },
        {
          "label": "Comedy",
          "value": "&genre%5B%5D=comedy"
        },
        {
          "label": "Drama",
          "value": "&genre%5B%5D=drama"
        },
        {
          "label": "Ecchi",
          "value": "&genre%5B%5D=ecchi"
        },
        {
          "label": "Fantasy",
          "value": "&genre%5B%5D=fantasy"
        },
        {
          "label": "Harem",
          "value": "&genre%5B%5D=harem"
        },
        {
          "label": "Historical",
          "value": "&genre%5B%5D=historical"
        },
        {
          "label": "Horror",
          "value": "&genre%5B%5D=horror"
        },
        {
          "label": "Isekai",
          "value": "&genre%5B%5D=isekai"
        },
        {
          "label": "Martial Arts",
          "value": "&genre%5B%5D=martial-arts"
        },
        {
          "label": "Mature",
          "value": "&genre%5B%5D=mature"
        },
        {
          "label": "Military",
          "value": "&genre%5B%5D=military"
        },
        {
          "label": "Mystery",
          "value": "&genre%5B%5D=mystery"
        },
        {
          "label": "Office",
          "value": "&genre%5B%5D=office"
        },
        {
          "label": "Psychological",
          "value": "&genre%5B%5D=psychological"
        },
        {
          "label": "Romance",
          "value": "&genre%5B%5D=romance"
        },
        {
          "label": "School Life",
          "value": "&genre%5B%5D=school-life"
        },
        {
          "label": "Sci-Fi",
          "value": "&genre%5B%5D=sci-fi"
        },
        {
          "label": "Slice of Life",
          "value": "&genre%5B%5D=slice-of-life"
        },
        {
          "label": "Sports",
          "value": "&genre%5B%5D=sports"
        },
        {
          "label": "Supernatural",
          "value": "&genre%5B%5D=supernatural"
        },
        {
          "label": "Thriller",
          "value": "&genre%5B%5D=thriller"
        },
        {
          "label": "Tragedy",
          "value": "&genre%5B%5D=tragedy"
        },
        {
          "label": "Yuri",
          "value": "&genre%5B%5D=yuri"
        }
      ]
    }
  ],
  "catalogs": [
    {
      "id": "trending",
      "name": "Trending",
      "url": "{baseUrl}/all/page/{page}/?m_orderby=trending"
    },
    {
      "id": "new",
      "name": "New",
      "url": "{baseUrl}/all/page/{page}/?m_orderby=new-manga"
    },
    {
      "id": "rating",
      "name": "Top rated",
      "url": "{baseUrl}/all/page/{page}/?m_orderby=rating"
    },
    {
      "id": "alphabet",
      "name": "A to Z",
      "url": "{baseUrl}/all/page/{page}/?m_orderby=alphabet"
    },
    {
      "id": "completed",
      "name": "Completed",
      "filters": {
        "status": "&status%5B%5D=end",
        "order": "&m_orderby=views"
      }
    }
  ],
  "details": {
    "url": "{entryUrl}",
    "fields": {
      "url": {
        "template": "{entryUrl}"
      },
      "title": {
        "selector": "div.post-title h1",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "div.summary_image img",
            "attr": "data-src"
          },
          {
            "selector": "meta[property=\"og:image\"]",
            "attr": "content"
          },
          {
            "selector": "div.summary_image img",
            "attr": "src"
          }
        ],
        "transform": "trim",
        "resolve": true
      },
      "description": {
        "or": [
          {
            "selector": "div.content-area div.summary__content",
            "attr": "text",
            "transform": "trim"
          },
          {
            "selector": "div.description-summary",
            "attr": "text",
            "transform": "trim"
          },
          {
            "selector": "meta[property=\"og:description\"]",
            "attr": "content"
          }
        ]
      },
      "author": {
        "selector": "div.author-content a",
        "attr": "text",
        "transform": "trim"
      },
      "status": {
        "selector": "div.post-content_item:contains(\"Status\") div.summary-content",
        "attr": "text",
        "transform": "trim"
      },
      "genres": {
        "selector": "div.genres-content a",
        "attr": "text",
        "all": true,
        "transform": "trim"
      }
    }
  },
  "chapters": {
    "url": "{entryUrl}ajax/chapters/",
    "method": "POST",
    "headers": {
      "X-Requested-With": "XMLHttpRequest"
    },
    "itemSelector": "li.wp-manga-chapter",
    "sort": {
      "by": "number",
      "order": "desc"
    },
    "fields": {
      "url": {
        "selector": "a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": "a",
        "attr": "text",
        "transform": "trim"
      },
      "number": {
        "selector": "a",
        "attr": "text",
        "regex": "([0-9.]+)",
        "transform": "number"
      },
      "dateUploaded": {
        "or": [
          {
            "selector": "span.chapter-release-date a",
            "attr": "title"
          },
          {
            "selector": "span.chapter-release-date",
            "attr": "text"
          }
        ],
        "transform": "parseDate"
      }
    }
  },
  "pages": {
    "url": "{chapterUrl}",
    "itemSelector": "div.reading-content img, div.page-break img, img.wp-manga-chapter-img",
    "fields": {
      "imageUrl": {
        "or": [
          {
            "attr": "data-src"
          },
          {
            "attr": "data-lazy-src"
          },
          {
            "attr": "src"
          }
        ],
        "transform": "trim",
        "resolve": true
      }
    }
  }
}
