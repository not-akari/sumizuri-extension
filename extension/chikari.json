        "path": "status",
        "transform": "capitalize"
      }
    }
  },
  "search": {
    "url": "{baseUrl}/api/series?q={query}&offset={offset}&limit={pageSize}",
    "pageSize": 24,
    "itemsPath": "items",
    "fields": {
      "url": {
        "template": "/series/{slug}",
        "resolve": true
      },
      "title": {
        "path": "title"
      },
      "coverUrl": {
        "path": "cover_url"
      },
      "rating": {
        "path": "rating",
        "round": 1
      },
      "status": {
        "path": "status",
        "transform": "capitalize"
      }
    },
    "upgrade": {
      "url": "{baseUrl}/api/series?q={query}{sort}{type}{status}{genre}&offset={offset}&limit={pageSize}"
    }
  },
  "filters": [
    {
      "key": "sort",
      "name": "Sort by",
      "type": "select",
      "options": [
        {
          "label": "Latest",
          "value": ""
        },
        {
          "label": "Popular",
          "value": "&sort=popular"
        }
      ]
    },
    {
      "key": "type",
      "name": "Type",
      "type": "select",
      "options": [
        {
          "label": "Any",
          "value": ""
        },
        {
          "label": "Manhwa",
          "value": "&type=manhwa"
        },
        {
          "label": "Manga",
          "value": "&type=manga"
        },
        {
          "label": "Manhua",
