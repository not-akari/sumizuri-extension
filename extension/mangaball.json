{
  "name": "MangaBall",
  "lang": "en",
  "baseUrl": "https://api.mangaball.com/api/v1",
  "webBaseUrl": "https://mangaball.com",
  "iconUrl": "https://mangaball.com/images/favicon.png",
  "rateLimitMs": 1000,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Referer": "https://mangaball.com/"
  },
  "popular": {
    "url": "{baseUrl}/title/search-advanced?sort_by=views&page={page}&limit=20",
    "itemsPath": "data",
    "fields": {
      "url": {
        "template": "{baseUrl}/title/detail/{id}"
      },
      "title": {
        "path": "name",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "join": [
              {
                "template": "https://bulbasaur.poke-black-and-white.net/covers/{id}/"
              },
              {
                "path": "image.cover.name"
              }
            ],
            "separator": "",
            "requireAll": true
          },
          {
            "path": "image.cdn_mangadex"
          },
          {
            "path": "image.file"
          }
        ]
      },
      "rating": {
        "path": "ratings.rating_average",
        "round": 1
      },
      "status": {
        "path": "status",
        "transform": "capitalize"
      },
      "genres": {
        "path": "tags",
        "map": "name"
      },
      "webUrl": {
        "template": "https://mangaball.com/title-detail/{id}"
      }
    }
  },
  "latest": {
    "url": "{baseUrl}/title/recently-updated?page={page}&limit=20",
    "itemsPath": "data",
    "fields": {
      "url": {
        "template": "{baseUrl}/title/detail/{id}"
      },
      "title": {
        "path": "name",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "join": [
              {
                "template": "https://bulbasaur.poke-black-and-white.net/covers/{id}/"
              },
              {
                "path": "image.cover.name"
              }
            ],
            "separator": "",
            "requireAll": true
          },
          {
            "path": "image.cdn_mangadex"
          },
          {
            "path": "image.file"
          }
        ]
      },
      "rating": {
        "path": "ratings.rating_average",
        "round": 1
      },
      "status": {
        "path": "status",
        "transform": "capitalize"
      },
      "genres": {
        "path": "tags",
        "map": "name"
      },
      "webUrl": {
        "template": "https://mangaball.com/title-detail/{id}"
      }
    }
  },
  "search": {
    "url": "{baseUrl}/title/search-advanced?keyword={query}&page={page}&limit=20",
    "itemsPath": "data",
    "fields": {
      "url": {
        "template": "{baseUrl}/title/detail/{id}"
      },
      "title": {
        "path": "name",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "join": [
              {
                "template": "https://bulbasaur.poke-black-and-white.net/covers/{id}/"
              },
              {
                "path": "image.cover.name"
              }
            ],
            "separator": "",
            "requireAll": true
          },
          {
            "path": "image.cdn_mangadex"
          },
          {
            "path": "image.file"
          }
        ]
      },
      "rating": {
        "path": "ratings.rating_average",
        "round": 1
      },
      "status": {
        "path": "status",
        "transform": "capitalize"
      },
      "genres": {
        "path": "tags",
        "map": "name"
      },
      "webUrl": {
        "template": "https://mangaball.com/title-detail/{id}"
      }
    },
    "upgrade": {
      "url": "{baseUrl}/title/search-advanced?keyword={query}&sort_by={sort}&status={status}&type={type}&page={page}&limit=20"
    }
  },
  "filters": [
    {
      "key": "sort",
      "name": "Sort by",
      "type": "select",
      "options": [
        {
          "label": "Most views",
          "value": "views"
        },
        {
          "label": "Latest update",
          "value": "latest"
        },
        {
          "label": "Rating",
          "value": "rating"
        },
        {
          "label": "Newly added",
          "value": "created_at"
        },
        {
          "label": "Most followed",
          "value": "follows"
        },
        {
          "label": "Name",
          "value": "name"
        }
      ]
    },
    {
      "key": "status",
      "name": "Status",
      "type": "select",
      "options": [
        {
          "label": "Any",
          "value": ""
        },
        {
          "label": "Ongoing",
          "value": "ongoing"
        },
        {
          "label": "Completed",
          "value": "completed"
        },
        {
          "label": "Hiatus",
          "value": "hiatus"
        },
        {
          "label": "Cancelled",
          "value": "cancelled"
        }
      ]
    },
    {
      "key": "type",
      "name": "Type",
      "type": "select",
      "options": [
        {
          "label": "Any",
          "value": ""
        },
        {
          "label": "Manga",
          "value": "manga"
        },
        {
          "label": "Manhwa",
          "value": "manhwa"
        },
        {
          "label": "Manhua",
          "value": "manhua"
        }
      ]
    }
  ],
  "catalogs": [
    {
      "id": "rating",
      "name": "Top rated",
      "url": "{baseUrl}/title/search-advanced?sort_by=rating&page={page}&limit=20"
    },
    {
      "id": "follows",
      "name": "Most followed",
      "url": "{baseUrl}/title/search-advanced?sort_by=follows&page={page}&limit=20"
    },
    {
      "id": "new",
      "name": "Newly added",
      "url": "{baseUrl}/title/search-advanced?sort_by=created_at&page={page}&limit=20"
    },
    {
      "id": "completed",
      "name": "Completed",
      "url": "{baseUrl}/title/search-advanced?sort_by=views&status=completed&page={page}&limit=20"
    },
    {
      "id": "manhwa",
      "name": "Manhwa",
      "url": "{baseUrl}/title/search-advanced?sort_by=views&type=manhwa&page={page}&limit=20"
    },
    {
      "id": "manga",
      "name": "Manga",
      "url": "{baseUrl}/title/search-advanced?sort_by=views&type=manga&page={page}&limit=20"
    }
  ],
  "details": {
    "url": "{entryUrl}",
    "itemsPath": "data",
    "fields": {
      "url": {
        "template": "{entryUrl}"
      },
      "title": {
        "path": "name",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "join": [
              {
                "template": "https://bulbasaur.poke-black-and-white.net/covers/{id}/"
              },
              {
                "path": "image.cover.name"
              }
            ],
            "separator": "",
            "requireAll": true
          },
          {
            "path": "image.cdn_mangadex"
          },
          {
            "path": "image.file"
          }
        ]
      },
      "description": {
        "or": [
          {
            "path": "description.0",
            "transform": "trim"
          },
          {
            "path": "description",
            "transform": "trim"
          }
        ]
      },
      "author": {
        "path": "authors.0.name",
        "transform": "trim"
      },
      "status": {
        "path": "status",
        "transform": "capitalize"
      },
      "rating": {
        "path": "ratings.rating_average",
        "round": 1
      },
      "genres": {
        "path": "tags",
        "map": "name"
      },
      "webUrl": {
        "template": "https://mangaball.com/title-detail/{id}"
      }
    }
  },
  "chapters": {
    "url": "{baseUrl}/title/chapter-listing?title_id={entrySlug}&page=1&limit=2000&group_by=flat&sort_order=desc&language=en",
    "itemsPath": "data",
    "sort": {
      "by": "number",
      "order": "desc"
    },
    "fields": {
      "url": {
        "template": "{baseUrl}/chapter-detail?chapter_id={id}"
      },
      "title": {
        "or": [
          {
            "path": "name",
            "transform": "trim"
          },
          {
            "template": "Chapter {number}"
          }
        ]
      },
      "number": {
        "path": "number",
        "transform": "number"
      },
      "dateUploaded": {
        "path": "created_at",
        "transform": "parseDate"
      },
      "scanlator": {
        "path": "group.name",
        "transform": "trim"
      }
    }
  },
  "pages": {
    "url": "{chapterUrl}",
    "itemsPath": "data.chapter.pages",
    "fields": {
      "imageUrl": {
        "if": "string",
        "then": {
          "path": ""
        },
        "else": {
          "path": "url"
        }
      }
    }
  }
}
