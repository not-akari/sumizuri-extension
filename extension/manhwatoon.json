  "details": {
    "url": "{entryUrl}",
    "fields": {
      "url": {
        "template": "{entryUrl}"
      },
      "title": {
        "selector": "div.post-title h1",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "div.summary_image img",
            "attr": "data-src"
          },
          {
            "selector": "meta[property=\"og:image\"]",
            "attr": "content"
          },
          {
            "selector": "div.summary_image img",
            "attr": "src"
          }
        ],
        "transform": "trim",
        "resolve": true
      },
      "description": {
        "or": [
          {
            "selector": "div.content-area div.summary__content",
            "attr": "text",
            "transform": "trim"
          },
          {
            "selector": "div.description-summary",
            "attr": "text",
            "transform": "trim"
          },
          {
            "selector": "meta[property=\"og:description\"]",
            "attr": "content"
          }
        ]
      },
      "author": {
        "selector": "div.author-content a",
        "attr": "text",
        "transform": "trim"
      },
      "status": {
        "selector": "div.post-content_item:contains(\"Status\") div.summary-content",
        "attr": "text",
        "transform": "trim"
      },
      "genres": {
        "selector": "div.genres-content a",
        "attr": "text",
        "all": true,
        "transform": "trim"
      }
    }
  },
  "chapters": {
    "url": "{entryUrl}ajax/chapters/",
    "method": "POST",
    "headers": {
      "X-Requested-With": "XMLHttpRequest"
    },
    "itemSelector": "li.wp-manga-chapter",
    "sort": {
      "by": "number",
      "order": "desc"
    },
    "fields": {
      "url": {
        "selector": "a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": "a",
        "attr": "text",
        "transform": "trim"
      },
      "number": {
        "selector": "a",
        "attr": "text",
        "regex": "([0-9.]+)",
        "transform": "number"
      },
      "dateUploaded": {
        "or": [
          {
            "selector": "span.chapter-release-date a",
            "attr": "title"
          },
          {
            "selector": "span.chapter-release-date",
            "attr": "text"
          }
        ],
        "transform": "parseDate"
      }
    }
  },
  "pages": {
    "url": "{chapterUrl}",
    "itemSelector": "div.reading-content img, div.page-break img, img.wp-manga-chapter-img",
    "fields": {
      "imageUrl": {
        "or": [
          {
            "attr": "data-src"
          },
          {
            "attr": "data-lazy-src"
          },
          {
            "attr": "src"
          }
        ],
        "transform": "trim",
        "resolve": true
      }
    }
  }
}
