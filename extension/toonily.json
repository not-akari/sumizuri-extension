{
  "name": "Toonily",
  "lang": "en",
  "baseUrl": "https://toonily.com",
  "iconUrl": "https://toonily.com/favicon.ico",
  "rateLimitMs": 1000,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Referer": "https://toonily.com/",
    "Cookie": "toonily-mature=1"
  },
  "popular": {
    "url": "{baseUrl}/serie/page/{page}/?m_orderby=views",
    "itemSelector": "div.page-item-detail.manga, div.page-item-detail",
    "fields": {
      "url": {
        "selector": ".post-title a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": ".post-title a",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "img",
            "attr": "data-src"
          },
          {
            "selector": "img",
            "attr": "src"
          }
        ],
        "resolve": true
      },
      "rating": {
        "selector": ".score",
        "attr": "text",
        "transform": "number",
        "round": 1
      }
    }
  },
  "latest": {
    "url": "{baseUrl}/serie/page/{page}/?m_orderby=latest",
    "itemSelector": "div.page-item-detail.manga, div.page-item-detail",
    "fields": {
      "url": {
        "selector": ".post-title a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": ".post-title a",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "img",
            "attr": "data-src"
          },
          {
            "selector": "img",
            "attr": "src"
          }
        ],
        "resolve": true
      },
      "rating": {
        "selector": ".score",
        "attr": "text",
        "transform": "number",
        "round": 1
      }
    }
  },
  "search": {
    "url": "{baseUrl}/search/{query}/page/{page}/?m_orderby={order}{status}{genre}",
    "itemSelector": "div.c-tabs-item__content, div.page-item-detail.manga, div.page-item-detail",
    "fields": {
      "url": {
        "selector": ".post-title a, h3.h4 a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": ".post-title a, h3.h4 a",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "img",
            "attr": "data-src"
          },
          {
            "selector": "img",
            "attr": "src"
          }
        ],
        "resolve": true
      },
      "rating": {
        "selector": ".score",
        "attr": "text",
        "transform": "number",
        "round": 1
      }
    },
    "emptyQueryUrl": "{baseUrl}/search/page/{page}/?m_orderby={order}{status}{genre}"
  },
  "filters": [
    {
      "key": "order",
      "name": "Sort by",
      "type": "select",
      "options": [
        {
          "label": "Relevance",
          "value": ""
        },
        {
          "label": "Latest update",
          "value": "latest"
        },
        {
          "label": "Most views",
          "value": "views"
        },
        {
          "label": "Trending",
          "value": "trending"
        },
        {
          "label": "Rating",
          "value": "rating"
        },
        {
          "label": "New",
          "value": "new-manga"
        },
        {
          "label": "A to Z",
          "value": "alphabet"
        }
      ]
    },
    {
      "key": "status",
      "name": "Status",
      "type": "select",
      "options": [
        {
          "label": "Any",
          "value": ""
        },
        {
          "label": "Ongoing",
          "value": "&status[]=on-going"
        },
        {
          "label": "Completed",
          "value": "&status[]=end"
        },
        {
          "label": "Hiatus",
          "value": "&status[]=on-hold"
        },
        {
          "label": "Canceled",
          "value": "&status[]=canceled"
        }
      ]
    },
    {
      "key": "genre",
      "name": "Genres",
      "type": "multiSelect",
      "join": "",
      "options": [
        {
          "label": "Action",
          "value": "&genre[]=action"
        },
        {
          "label": "Adventure",
          "value": "&genre[]=adventure"
        },
        {
          "label": "Comedy",
          "value": "&genre[]=comedy"
        },
        {
          "label": "Crime",
          "value": "&genre[]=crime"
        },
        {
          "label": "Drama",
          "value": "&genre[]=drama"
        },
        {
          "label": "Fantasy",
          "value": "&genre[]=fantasy"
        },
        {
          "label": "Gossip",
          "value": "&genre[]=gossip"
        },
        {
          "label": "Historical",
          "value": "&genre[]=historical"
        },
        {
          "label": "Horror",
          "value": "&genre[]=horror"
        },
        {
          "label": "Isekai",
          "value": "&genre[]=isekai"
        },
        {
          "label": "Josei",
          "value": "&genre[]=josei"
        },
        {
          "label": "Magic",
          "value": "&genre[]=magic"
        },
        {
          "label": "Mature",
          "value": "&genre[]=mature"
        },
        {
          "label": "Mystery",
          "value": "&genre[]=mystery"
        },
        {
          "label": "Psychological",
          "value": "&genre[]=psychological"
        },
        {
          "label": "Romance",
          "value": "&genre[]=romance"
        },
        {
          "label": "School Life",
          "value": "&genre[]=school-life"
        },
        {
          "label": "Sci-Fi",
          "value": "&genre[]=scifi-webtoon"
        },
        {
          "label": "Seinen",
          "value": "&genre[]=seinen"
        },
        {
          "label": "Shoujo",
          "value": "&genre[]=shoujo"
        },
        {
          "label": "Shounen",
          "value": "&genre[]=shounen"
        },
        {
          "label": "Slice of Life",
          "value": "&genre[]=slice-of-life"
        },
        {
          "label": "Sports",
          "value": "&genre[]=sports"
        },
        {
          "label": "Supernatural",
          "value": "&genre[]=supernatural"
        },
        {
          "label": "Thriller",
          "value": "&genre[]=thriller"
        },
        {
          "label": "Tragedy",
          "value": "&genre[]=tragedy"
        },
        {
          "label": "Villainess",
          "value": "&genre[]=villainess"
        },
        {
          "label": "Wuxia",
          "value": "&genre[]=wuxia"
        },
        {
          "label": "Yaoi",
          "value": "&genre[]=yaoi"
        },
        {
          "label": "Yuri",
          "value": "&genre[]=yuri"
        }
      ]
    }
  ],
  "catalogs": [
    {
      "id": "trending",
      "name": "Trending",
      "url": "{baseUrl}/serie/page/{page}/?m_orderby=trending"
    },
    {
      "id": "new",
      "name": "New",
      "url": "{baseUrl}/serie/page/{page}/?m_orderby=new-manga"
    },
    {
      "id": "rating",
      "name": "Top rated",
      "url": "{baseUrl}/serie/page/{page}/?m_orderby=rating"
    },
    {
      "id": "alphabet",
      "name": "A to Z",
      "url": "{baseUrl}/serie/page/{page}/?m_orderby=alphabet"
    },
    {
      "id": "completed",
      "name": "Completed",
      "filters": {
        "status": "&status[]=end",
        "order": "latest"
      }
    }
  ],
  "details": {
    "url": "{entryUrl}",
    "fields": {
      "url": {
        "template": "{entryUrl}"
      },
      "title": {
        "selector": "div.post-title h1",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "div.summary_image img",
            "attr": "data-src"
          },
          {
            "selector": "meta[property=\"og:image\"]",
            "attr": "content"
          },
          {
            "selector": "div.summary_image img",
            "attr": "src"
          }
        ],
        "resolve": true
      },
      "description": {
        "or": [
          {
            "selector": "div.content-area div.summary__content",
            "attr": "text",
            "transform": "trim"
          },
          {
            "selector": "div.description-summary",
            "attr": "text",
            "transform": "trim"
          },
          {
            "selector": "meta[property=\"og:description\"]",
            "attr": "content"
          }
        ]
      },
      "author": {
        "selector": "div.author-content a",
        "attr": "text",
        "transform": "trim"
      },
      "status": {
        "selector": "div.post-status div.summary-content",
        "attr": "text",
        "transform": "trim"
      },
      "genres": {
        "selector": "div.genres-content a",
        "attr": "text",
        "all": true,
        "transform": "trim"
      }
    }
  },
  "chapters": {
    "url": "{baseUrl}/serie/{entrySlug}/ajax/chapters/",
    "method": "POST",
    "headers": {
      "X-Requested-With": "XMLHttpRequest"
    },
    "itemSelector": "li.wp-manga-chapter",
    "sort": {
      "by": "number",
      "order": "desc"
    },
    "fields": {
      "url": {
        "selector": "a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": "a",
        "attr": "text",
        "transform": "trim"
      },
      "number": {
        "selector": "a",
        "attr": "text",
        "regex": "([0-9.]+)",
        "transform": "number"
      },
      "dateUploaded": {
        "selector": "span.chapter-release-date",
        "attr": "text",
        "transform": "parseDate"
      }
    }
  },
  "pages": {
    "url": "{chapterUrl}",
    "itemSelector": "div.reading-content img, div.page-break img",
    "fields": {
      "imageUrl": {
        "or": [
          {
            "attr": "data-src"
          },
          {
            "attr": "data-lazy-src"
          },
          {
            "attr": "src"
          }
        ],
        "resolve": true
      }
    }
  }
}
