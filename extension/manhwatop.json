{
  "name": "ManhwaTop",
  "lang": "en",
  "baseUrl": "https://manhwatop.com",
  "iconUrl": "https://raw.githubusercontent.com/not-akari/Sumizuri-Extension/main/docs/icons/manhwatop.jpg",
  "rateLimitMs": 1000,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Referer": "https://manhwatop.com/"
  },
  "popular": {
    "url": "{baseUrl}/manga/page/{page}/?m_orderby=views",
    "itemSelector": "div.page-item-detail.manga, div.page-item-detail",
    "fields": {
      "url": {
        "selector": ".post-title a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": ".post-title a",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "img",
            "attr": "data-src"
          },
          {
            "selector": "img",
            "attr": "src"
          }
        ],
        "resolve": true
      },
      "rating": {
        "selector": ".score",
        "attr": "text",
        "transform": "number",
        "round": 1
      }
    }
  },
  "latest": {
    "url": "{baseUrl}/manga/page/{page}/?m_orderby=latest",
    "itemSelector": "div.page-item-detail.manga, div.page-item-detail",
    "fields": {
      "url": {
        "selector": ".post-title a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": ".post-title a",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "img",
            "attr": "data-src"
          },
          {
            "selector": "img",
            "attr": "src"
          }
        ],
        "resolve": true
      },
      "rating": {
        "selector": ".score",
        "attr": "text",
        "transform": "number",
        "round": 1
      }
    }
  },
  "search": {
    "url": "{baseUrl}/page/{page}/?s={query}&post_type=wp-manga",
    "itemSelector": "div.c-tabs-item__content, div.page-item-detail.manga, div.page-item-detail",
    "fields": {
      "url": {
        "selector": ".post-title a, h3.h4 a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": ".post-title a, h3.h4 a",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "img",
            "attr": "data-src"
          },
          {
            "selector": "img",
            "attr": "src"
          }
        ],
        "resolve": true
      },
      "rating": {
        "selector": ".score",
        "attr": "text",
        "transform": "number",
        "round": 1
      }
    },
    "upgrade": {
      "url": "{baseUrl}/page/{page}/?s={queryPlus}&post_type=wp-manga{order}{status}{genre}"
    }
  },
