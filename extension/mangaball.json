{
  "name": "MangaBall",
  "lang": "en",
  "baseUrl": "https://api.mangaball.com/api/v1",
  "webBaseUrl": "https://mangaball.com",
  "iconUrl": "https://mangaball.com/images/favicon.png",
  "rateLimitMs": 1000,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Referer": "https://mangaball.com/"
  },
  "popular": {
    "url": "{baseUrl}/title/search-advanced?sort_by=views&page={page}&limit=20",
    "itemsPath": "data",
    "fields": {
      "url": {
        "template": "{baseUrl}/title/detail/{id}"
      },
      "title": {
        "path": "name",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "join": [
              { "template": "https://bulbasaur.poke-black-and-white.net/covers/{id}/" },
              { "path": "image.cover.name" }
            ],
            "separator": "",
            "requireAll": true
          },
          {
            "path": "image.cdn_mangadex"
          },
          {
            "path": "image.file"
          }
        ]
      },
      "rating": {
        "path": "ratings.rating_average",
        "round": 1
      },
      "status": {
        "path": "status",
        "transform": "capitalize"
      },
      "genres": {
        "path": "tags",
        "map": "name"
      },
      "webUrl": {
        "template": "https://mangaball.com/title-detail/{id}"
      }
    }
  },
  "latest": {
    "url": "{baseUrl}/title/recently-updated?page={page}&limit=20",
    "itemsPath": "data",
    "fields": {
      "url": {
        "template": "{baseUrl}/title/detail/{id}"
      },
      "title": {
        "path": "name",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "join": [
              { "template": "https://bulbasaur.poke-black-and-white.net/covers/{id}/" },
              { "path": "image.cover.name" }
            ],
            "separator": "",
            "requireAll": true
          },
          {
            "path": "image.cdn_mangadex"
          },
          {
            "path": "image.file"
          }
        ]
      },
      "rating": {
        "path": "ratings.rating_average",
        "round": 1
      },
      "status": {
        "path": "status",
        "transform": "capitalize"
      },
      "genres": {
        "path": "tags",
        "map": "name"
      },
      "webUrl": {
        "template": "https://mangaball.com/title-detail/{id}"
      }
    }
  },
  "search": {
    "url": "{baseUrl}/title/search-advanced?keyword={query}&page={page}&limit=20",
    "itemsPath": "data",
    "fields": {
      "url": {
        "template": "{baseUrl}/title/detail/{id}"
      },
      "title": {
        "path": "name",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "join": [
              { "template": "https://bulbasaur.poke-black-and-white.net/covers/{id}/" },
              { "path": "image.cover.name" }
            ],
            "separator": "",
            "requireAll": true
          },
          {
            "path": "image.cdn_mangadex"
          },
          {
            "path": "image.file"
          }
        ]
      },
      "rating": {
        "path": "ratings.rating_average",
        "round": 1
      },
      "status": {
        "path": "status",
        "transform": "capitalize"
      },
      "genres": {
        "path": "tags",
        "map": "name"
      },
      "webUrl": {
        "template": "https://mangaball.com/title-detail/{id}"
      }
    }
  },
  "details": {
    "url": "{entryUrl}",
    "itemsPath": "data",
    "fields": {
      "url": {
        "template": "{entryUrl}"
      },
      "title": {
        "path": "name",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "join": [
              { "template": "https://bulbasaur.poke-black-and-white.net/covers/{id}/" },
              { "path": "image.cover.name" }
            ],
            "separator": "",
            "requireAll": true
          },
          {
            "path": "image.cdn_mangadex"
          },
          {
            "path": "image.file"
          }
        ]
      },
      "description": {
        "or": [
          {
            "path": "description.0",
            "transform": "trim"
          },
          {
            "path": "description",
            "transform": "trim"
          }
        ]
      },
      "author": {
        "path": "authors.0.name",
        "transform": "trim"
      },
      "status": {
        "path": "status",
        "transform": "capitalize"
      },
      "rating": {
        "path": "ratings.rating_average",
        "round": 1
      },
      "genres": {
        "path": "tags",
        "map": "name"
      },
      "webUrl": {
        "template": "https://mangaball.com/title-detail/{id}"
      }
    }
  },
  "chapters": {
    "url": "{baseUrl}/title/chapter-listing?title_id={entrySlug}&page=1&limit=2000&group_by=flat&sort_order=desc&language=en",
    "itemsPath": "data",
    "sort": {
      "by": "number",
      "order": "desc"
    },
    "fields": {
      "url": {
        "template": "{baseUrl}/chapter-detail?chapter_id={id}"
      },
      "title": {
        "or": [
          {
            "path": "name",
            "transform": "trim"
          },
          {
            "template": "Chapter {number}"
          }
        ]
      },
      "number": {
        "path": "number",
        "transform": "number"
      },
      "dateUploaded": {
        "path": "created_at",
        "transform": "parseDate"
      },
      "scanlator": {
        "path": "group.name",
        "transform": "trim"
      }
    }
  },
  "pages": {
    "url": "{chapterUrl}",
    "itemsPath": "data.chapter.pages",
    "fields": {
      "imageUrl": {
        "if": "string",
        "then": {
          "path": ""
        },
        "else": {
          "path": "url"
        }
      }
    }
  }
}
