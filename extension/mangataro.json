{
  "name": "MangaTaro",
  "lang": "en",
  "baseUrl": "https://mangataro.org",
  "iconUrl": "https://mangataro.org/wp-content/uploads/2024/07/cropped-cropped-fav-192x192.png",
  "rateLimitMs": 800,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Referer": "https://mangataro.org/"
  },
  "popular": {
    "url": "{baseUrl}/?s=&orderby=views",
    "itemSelector": "div.grid div.group",
    "fields": {
      "url": {
        "selector": "a[href*=\"/manga/\"]",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "or": [
          {
            "selector": "h3",
            "attr": "text"
          },
          {
            "selector": "img[alt]",
            "attr": "alt"
          },
          {
            "selector": "a[href*=\"/manga/\"]",
            "attr": "title"
          }
        ],
        "transform": "trim"
      },
      "coverUrl": {
        "selector": "img",
        "attr": "src",
        "resolve": true
      }
    }
  },
  "latest": {
    "url": "{baseUrl}/?s=&orderby=date",
    "itemSelector": "div.grid div.group",
    "fields": {
      "url": {
        "selector": "a[href*=\"/manga/\"]",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "or": [
          {
            "selector": "h3",
            "attr": "text"
          },
          {
            "selector": "img[alt]",
            "attr": "alt"
          },
          {
            "selector": "a[href*=\"/manga/\"]",
            "attr": "title"
          }
        ],
        "transform": "trim"
      },
      "coverUrl": {
        "selector": "img",
        "attr": "src",
        "resolve": true
      }
    }
  },
  "search": {
    "url": "{baseUrl}/?s={query}",
    "itemSelector": "div.grid div.group",
    "fields": {
      "url": {
        "selector": "a[href*=\"/manga/\"]",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "or": [
          {
            "selector": "h3",
            "attr": "text"
          },
          {
            "selector": "img[alt]",
            "attr": "alt"
          },
          {
            "selector": "a[href*=\"/manga/\"]",
            "attr": "title"
          }
        ],
        "transform": "trim"
      },
      "coverUrl": {
        "selector": "img",
        "attr": "src",
        "resolve": true
      }
    }
  },
  "details": {
    "url": "{entryUrl}",
    "fields": {
      "url": {
        "template": "{entryUrl}"
      },
      "title": {
        "or": [
          {
            "selector": "h1",
            "attr": "text"
          },
          {
            "selector": "meta[property=\"og:title\"]",
            "attr": "content"
          }
        ],
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "meta[property=\"og:image\"]",
            "attr": "content"
          }
        ],
        "resolve": true
      },
      "description": {
        "or": [
          {
            "selector": "#description-content-tab",
            "attr": "text"
          },
          {
            "selector": "meta[property=\"og:description\"]",
            "attr": "content"
          }
        ],
        "transform": "trim"
      },
      "genres": {
        "selector": "a[href*=\"/tag/\"], a[href*=\"/genre/\"]",
        "attr": "text",
        "all": true,
        "transform": "trim"
      },
      "status": {
        "selector": ".status",
        "attr": "text",
        "transform": "capitalize",
        "default": "Ongoing"
      }
    }
  },
  "chapters": {
    "url": "{entryUrl}",
    "render": {
      "waitFor": ".chapter-list a, a[href*=\"/read/\"]"
    },
    "itemSelector": ".chapter-list a, a[href*=\"/read/\"]",
    "fields": {
      "url": {
        "attr": "href",
        "resolve": true
      },
      "title": {
        "attr": "text",
        "transform": "trim"
      },
      "number": {
        "attr": "text",
        "regex": "([0-9.]+)",
        "transform": "number"
      }
    }
  },
  "pages": {
    "url": "{chapterUrl}",
    "render": {
      "waitFor": ".comic-image-container img"
    },
    "itemSelector": ".comic-image-container img",
    "fields": {
      "imageUrl": {
        "or": [
          {
            "attr": "src"
          },
          {
            "attr": "data-src"
          }
        ],
        "resolve": true
      }
    }
  }
}
