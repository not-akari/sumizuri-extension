  "catalogs": [
    {
      "id": "new",
      "name": "Newest",
      "url": "{baseUrl}/genre-all/sort-new/status-all/all-novel?page={page}"
    },
    {
      "id": "completed",
      "name": "Completed",
      "url": "{baseUrl}/genre-all/sort-popular/status-completed/all-novel?page={page}"
    },
    {
      "id": "chinese",
      "name": "Chinese",
