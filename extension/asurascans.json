{
  "name": "Asura Scans",
  "lang": "en",
  "baseUrl": "https://api.asurascans.com",
  "webBaseUrl": "https://asurascans.com",
  "iconUrl": "https://asurascans.com/icons/apple-touch-icon.png",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/134.0.0.0 Safari/537.36",
    "Referer": "https://asurascans.com/"
  },
  "popular": {
    "url": "{baseUrl}/api/series?sort=popular&order=desc&limit={pageSize}&offset={offset}",
    "pageSize": 20,
    "itemsPath": "data",
    "fields": {
      "url": {
        "template": "{baseUrl}/api/series/{slug}"
      },
      "title": {
        "path": "title"
      },
      "coverUrl": {
        "path": "cover"
      },
      "bannerUrl": {
        "or": [
          {
            "path": "banner"
          },
          {
            "path": "cover"
          }
        ]
      },
      "rating": {
        "path": "rating",
        "round": 1
      },
      "status": {
        "path": "status",
        "transform": "capitalize"
      },
      "genres": {
        "path": "genres",
        "map": "name"
      },
      "webUrl": {
        "path": "public_url",
        "resolveWeb": true
      }
    }
  },
  "latest": {
    "url": "{baseUrl}/api/series?sort=update&order=desc&limit={pageSize}&offset={offset}",
    "pageSize": 20,
    "itemsPath": "data",
    "fields": {
      "url": {
        "template": "{baseUrl}/api/series/{slug}"
      },
      "title": {
        "path": "title"
      },
      "coverUrl": {
        "path": "cover"
      },
      "bannerUrl": {
        "or": [
          {
            "path": "banner"
          },
          {
            "path": "cover"
          }
        ]
      },
      "rating": {
        "path": "rating",
        "round": 1
      },
      "status": {
        "path": "status",
        "transform": "capitalize"
      },
      "genres": {
        "path": "genres",
        "map": "name"
      },
      "webUrl": {
        "path": "public_url",
        "resolveWeb": true
      }
    }
  },
  "search": {
    "url": "{baseUrl}/api/series?search={query}&limit={pageSize}&offset={offset}",
    "pageSize": 20,
    "itemsPath": "data",
    "fields": {
      "url": {
        "template": "{baseUrl}/api/series/{slug}"
      },
      "title": {
        "path": "title"
      },
      "coverUrl": {
        "path": "cover"
      },
      "bannerUrl": {
        "or": [
          {
            "path": "banner"
          },
          {
            "path": "cover"
          }
        ]
      },
      "rating": {
        "path": "rating",
        "round": 1
      },
      "status": {
        "path": "status",
        "transform": "capitalize"
      },
      "genres": {
        "path": "genres",
        "map": "name"
      },
      "webUrl": {
        "path": "public_url",
        "resolveWeb": true
      }
    },
    "upgrade": {
      "url": "{baseUrl}/api/series?search={query}&sort={sort}&order=desc&status={status}&genres={genre}&limit={pageSize}&offset={offset}"
    }
  },
  "filters": [
    {
      "key": "sort",
      "name": "Sort by",
      "type": "select",
      "options": [
        {
          "label": "Best match",
          "value": ""
        },
        {
          "label": "Popular",
          "value": "popular"
        },
        {
          "label": "Latest update",
          "value": "update"
        },
        {
          "label": "Rating",
          "value": "rating"
        },
        {
          "label": "Title",
          "value": "title"
        }
      ]
    },
    {
      "key": "status",
      "name": "Status",
      "type": "select",
      "options": [
        {
          "label": "Any",
          "value": ""
        },
        {
          "label": "Ongoing",
          "value": "ongoing"
        },
        {
          "label": "Completed",
          "value": "completed"
        },
        {
          "label": "Hiatus",
          "value": "hiatus"
        },
        {
          "label": "Dropped",
          "value": "dropped"
        }
      ]
    },
    {
      "key": "genre",
      "name": "Genres (all of)",
      "type": "multiSelect",
      "join": ",",
      "options": [
        {
          "label": "Action",
          "value": "action"
        },
        {
          "label": "Adventure",
          "value": "adventure"
        },
        {
          "label": "Comedy",
          "value": "comedy"
        },
        {
          "label": "Crazy MC",
          "value": "crazy-mc"
        },
        {
          "label": "Dark Fantasy",
          "value": "dark-fantasy"
        },
        {
          "label": "Demon",
          "value": "demon"
        },
        {
          "label": "Drama",
          "value": "drama"
        },
        {
          "label": "Dungeons",
          "value": "dungeons"
        },
        {
          "label": "Fantasy",
          "value": "fantasy"
        },
        {
          "label": "Game",
          "value": "game"
        },
        {
          "label": "Genius MC",
          "value": "genius-mc"
        },
        {
          "label": "Isekai",
          "value": "isekai"
        },
        {
          "label": "Magic",
          "value": "magic"
        },
        {
          "label": "Martial Arts",
          "value": "martial-arts"
        },
        {
          "label": "Murim",
          "value": "murim"
        },
        {
          "label": "Mystery",
          "value": "mystery"
        },
        {
          "label": "Necromancer",
          "value": "necromancer"
        },
        {
          "label": "Overpowered",
          "value": "overpowered"
        },
        {
          "label": "Psychological",
          "value": "psychological"
        },
        {
          "label": "Regression",
          "value": "regression"
        },
        {
          "label": "Reincarnation",
          "value": "reincarnation"
        },
        {
          "label": "Revenge",
          "value": "revenge"
        },
        {
          "label": "Romance",
          "value": "romance"
        },
        {
          "label": "School Life",
          "value": "school-life"
        },
        {
          "label": "Sci-fi",
          "value": "sci-fi"
        },
        {
          "label": "Shoujo",
          "value": "shoujo"
        },
        {
          "label": "Shounen",
          "value": "shounen"
        },
        {
          "label": "Supernatural",
          "value": "supernatural"
        },
        {
          "label": "System",
          "value": "system"
        },
        {
          "label": "Tower",
          "value": "tower"
        },
        {
          "label": "Tragedy",
          "value": "tragedy"
        },
        {
          "label": "Transmigration",
          "value": "transmigration"
        },
        {
          "label": "Villain",
          "value": "villain"
        },
        {
          "label": "Violence",
          "value": "violence"
        }
      ]
    }
  ],
  "catalogs": [
    {
      "id": "rating",
      "name": "Top rated",
      "url": "{baseUrl}/api/series?sort=rating&order=desc&limit={pageSize}&offset={offset}"
    },
    {
      "id": "completed",
      "name": "Completed",
      "url": "{baseUrl}/api/series?sort=popular&order=desc&status=completed&limit={pageSize}&offset={offset}"
    },
    {
      "id": "alphabet",
      "name": "A to Z",
      "url": "{baseUrl}/api/series?sort=title&order=asc&limit={pageSize}&offset={offset}"
    }
  ],
  "chapters": {
    "url": "{baseUrl}/api/series/{entrySlug}/chapters",
    "itemsPath": "data",
    "sort": {
      "by": "number",
      "order": "desc"
    },
    "fields": {
      "url": {
        "template": "{baseUrl}/api/series/{series_slug}/chapters/{slug}"
      },
      "title": {
        "if": {
          "path": "title",
          "is": "truthy"
        },
        "then": {
          "template": "Chapter {number} - {title}"
        },
        "else": {
          "template": "Chapter {number}"
        }
      },
      "number": {
        "path": "number"
      },
      "dateUploaded": {
        "path": "published_at"
      },
      "locked": {
        "path": "is_premium"
      },
      "unlocksAt": {
        "path": "early_access_until"
      }
    }
  },
  "pages": {
    "url": "{chapterUrl}",
    "itemsPath": "data.chapter.pages",
    "fields": {
      "imageUrl": {
        "path": "url"
      }
    }
  },
  "details": {
    "url": "{baseUrl}/api/series/{entrySlug}",
    "itemsPath": "series",
    "fields": {
      "url": {
        "template": "{baseUrl}/api/series/{entrySlug}"
      },
      "title": {
        "path": "title"
      },
      "coverUrl": {
        "path": "cover"
      },
      "bannerUrl": {
        "or": [
          {
            "path": "banner"
          },
          {
            "path": "cover"
          }
        ]
      },
      "author": {
        "path": "author"
      },
      "description": {
        "path": "description"
      },
      "rating": {
        "path": "rating",
        "round": 1
      },
      "status": {
        "path": "status",
        "transform": "capitalize"
      },
      "genres": {
        "path": "genres",
        "map": "name"
      },
      "webUrl": {
        "path": "public_url",
        "resolveWeb": true
      }
    }
  },
  "comments": {
    "resolve": {
      "url": "{baseUrl}/api/series/{entrySlug}",
      "path": "series.id",
      "as": "seriesId"
    },
    "url": "{baseUrl}/api/series/{seriesId}/comments?sort={sort}",
    "itemsPath": "data",
    "fields": {
      "author": {
        "path": "user.username",
        "default": "Anonymous"
      },
      "text": {
        "or": [
          {
            "path": "content"
          },
          {
            "path": "gif_url"
          }
        ],
        "default": ""
      },
      "avatarUrl": {
        "path": "user.profile_picture_url"
      },
      "date": {
        "path": "created_at"
      }
    }
  },
  "chapterComments": {
    "resolve": {
      "url": "{chapterUrl}",
      "path": "data.chapter.id",
      "as": "chapterId"
    },
    "url": "{baseUrl}/api/chapters/{chapterId}/comments?sort={sort}",
    "itemsPath": "data",
    "fields": {
      "author": {
        "path": "user.username",
        "default": "Anonymous"
      },
      "text": {
        "or": [
          {
            "path": "content"
          },
          {
            "path": "gif_url"
          }
        ],
        "default": ""
      },
      "avatarUrl": {
        "path": "user.profile_picture_url"
      },
      "date": {
        "path": "created_at"
      }
    }
  }
}
