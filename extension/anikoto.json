      },
      "coverUrl": {
        "selector": ".poster img",
        "attr": "src",
        "resolve": true
      },
      "rating": {
        "selector": ".rated span",
        "attr": "text",
        "transform": "number",
        "round": 1
      }
    }
  },
  "search": {
    "url": "{baseUrl}/filter?keyword={query}&page={page}",
    "itemSelector": "div#list-items .item",
    "fields": {
      "url": {
        "join": [
