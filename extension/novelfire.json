{
  "name": "Novel Fire",
  "lang": "en",
  "baseUrl": "https://novelfire.net",
  "iconUrl": "https://novelfire.net/favicon.ico",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
  },
  "popular": {
    "url": "{baseUrl}/genre-all/sort-popular/status-all/all-novel?page={page}",
    "itemSelector": "ul.novel-list li.novel-item",
    "fields": {
      "url": {
        "selector": "a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": ".novel-title",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "figure.novel-cover img",
            "attr": "data-src",
            "resolve": true
          },
          {
            "selector": "figure.novel-cover img",
            "attr": "src",
            "resolve": true
          }
        ]
      }
    }
  },
  "latest": {
    "url": "{baseUrl}/genre-all/sort-latest-release/status-all/all-novel?page={page}",
    "itemSelector": "ul.novel-list li.novel-item",
    "fields": {
      "url": {
        "selector": "a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": ".novel-title",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "figure.novel-cover img",
            "attr": "data-src",
            "resolve": true
          },
          {
            "selector": "figure.novel-cover img",
            "attr": "src",
            "resolve": true
          }
        ]
      }
    }
  },
  "search": {
    "url": "{baseUrl}/search?keyword={query}&page={page}",
    "itemSelector": "ul.novel-list li.novel-item",
    "fields": {
      "url": {
        "selector": "a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": ".novel-title",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "figure.novel-cover img",
            "attr": "data-src",
            "resolve": true
          },
          {
            "selector": "figure.novel-cover img",
            "attr": "src",
            "resolve": true
          }
        ]
      }
    },
    "upgrade": {
      "emptyQueryUrl": "{baseUrl}/genre-{genre}/sort-{sort}/status-{status}/{lang}?page={page}"
    }
  },
  "filters": [
    {
      "key": "sort",
      "name": "Sort by (without search words)",
      "type": "select",
      "options": [
        {
          "label": "Popular",
          "value": "popular"
        },
        {
          "label": "Newest",
          "value": "new"
        },
        {
          "label": "Latest release",
          "value": "latest-release"
        }
