  "details": {
    "url": "{entryUrl}",
    "fields": {
      "url": {
        "template": "{entryUrl}"
      },
      "title": {
        "selector": "h1",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "selector": "meta[property=\"og:image\"]",
        "attr": "content"
      },
      "description": {
        "selector": "meta[property=\"og:description\"]",
        "attr": "content"
      },
      "rating": {
        "selector": "span:has(svg.lucide-star)",
        "attr": "text",
        "regex": "([0-9.]+)",
        "transform": "number"
      },
      "genres": {
        "selector": "a[href*=\"genre=\"]",
        "attr": "text",
        "all": true,
        "transform": "trim"
      }
    }
  },
  "chapters": {
    "url": "{entryUrl}",
    "itemSelector": "div[data-chapter-row]",
    "sort": {
      "by": "number",
      "order": "desc"
    },
    "fields": {
      "url": {
        "selector": "a[href*='/chapter/']",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": "a[href*='/chapter/'] span.font-medium",
        "attr": "text",
        "transform": "trim"
      },
      "number": {
        "selector": "a[href*='/chapter/'] span.font-medium",
        "attr": "text",
        "regex": "(?:Chapter|Ch.?)s*([0-9.]+)",
        "transform": "number"
      },
      "dateUploaded": {
        "selector": "div.text-xs span.inline-flex span",
        "attr": "text",
        "transform": "parseDate"
      }
    },
    "upgrade": {
      "fields": {
        "url": {
          "selector": "a[href*='/chapter/']",
          "attr": "href",
          "resolve": true
        },
        "title": {
          "selector": "a[href*='/chapter/'] span.font-medium",
          "attr": "text",
          "transform": "trim"
        },
        "number": {
          "selector": "a[href*='/chapter/'] span.font-medium",
          "attr": "text",
          "regex": "(?:Chapter|Ch.?)s*([0-9.]+)",
          "transform": "number"
        },
        "dateUploaded": {
          "selector": "div.text-xs span.inline-flex span",
          "attr": "text",
          "transform": "parseDate"
        },
        "locked": {
          "selector": "span.sr-only:contains(\"Locked\")",
          "attr": "text",
          "transform": "exists"
        }
      }
    }
  },
  "pages": {
    "url": "{chapterUrl}",
    "itemsRegex": "imageUrl\\\\\":\\\\\"(https?://[^\\\\\"]+)",
    "fields": {
      "imageUrl": {
        "path": ""
      }
    }
  }
}
