{
  "name": "Anikoto",
  "lang": "en",
  "baseUrl": "https://anikototv.to",
  "iconUrl": "https://anikototv.to/AnikotoTheme/assets/images/favicon.png",
  "rateLimitMs": 500,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "X-Requested-With": "XMLHttpRequest",
    "Referer": "https://anikototv.to/"
  },
  "popular": {
    "url": "{baseUrl}/most-viewed?page={page}",
    "itemSelector": "div#list-items .item",
    "fields": {
      "url": {
        "join": [
          {
            "template": "{baseUrl}/ajax/anime/tooltip"
          },
          {
            "selector": "div.tip",
            "attr": "data-tip"
          }
        ],
        "separator": "/"
      },
      "webUrl": {
        "selector": "a.name.d-title",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": "a.name.d-title",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "selector": ".poster img",
        "attr": "src",
        "resolve": true
      },
      "rating": {
        "selector": ".rated span",
        "attr": "text",
        "transform": "number",
        "round": 1
      }
    }
  },
  "latest": {
    "url": "{baseUrl}/latest-updated?page={page}",
    "itemSelector": "div#list-items .item",
