    {
      "id": "action",
      "name": "Action",
      "url": "{baseUrl}/l/0zkHB?sort=views&page={page}"
    },
    {
      "id": "romance",
      "name": "Romance",
      "url": "{baseUrl}/l/0zjas?sort=views&page={page}"
    },
    {
      "id": "fantasy",
      "name": "Fantasy",
      "url": "{baseUrl}/l/0zkxQ?sort=views&page={page}"
    },
    {
      "id": "comedy",
      "name": "Comedy",
      "url": "{baseUrl}/l/0zkPw?sort=views&page={page}"
    }
  ],
  "details": {
    "url": "{entryUrl}",
    "fields": {
      "url": {
        "template": "{entryUrl}"
      },
      "title": {
        "or": [
          {
            "selector": "ol.breadcrumb li:last-child",
            "attr": "text"
          },
          {
            "selector": "h1",
            "attr": "text"
          },
          {
            "selector": "meta[property=\"og:title\"]",
            "attr": "content"
          }
        ],
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "img.thumbnail",
            "attr": "src"
          },
          {
            "selector": "meta[property=\"og:image\"]",
            "attr": "content"
          }
        ],
        "resolve": true
      },
      "description": {
        "or": [
          {
            "selector": ".series-summary .summary-content",
            "attr": "text"
          },
          {
            "selector": ".series-synopsis",
            "attr": "text"
          },
          {
            "selector": "meta[property=\"og:description\"]",
            "attr": "content"
          }
        ],
        "transform": "trim"
      },
      "status": {
        "or": [
          {
            "selector": "li:contains(\"Status\") a",
            "attr": "text"
          },
          {
            "selector": ".series-status",
            "attr": "text"
          }
        ],
        "transform": "capitalize",
        "default": "Ongoing"
      },
      "author": {
        "selector": "li:contains(\"Author\") small a",
        "attr": "text",
        "transform": "trim"
      },
      "genres": {
        "selector": "li:contains(\"Genre\") small a",
        "attr": "text",
        "all": true,
        "transform": "trim"
      }
    }
  },
  "chapters": {
    "url": "{entryUrl}",
    "itemSelector": "ul.list-chapters a[href*=\"/c/\"]",
    "fields": {
      "url": {
        "attr": "href",
        "resolve": true
      },
      "title": {
        "or": [
          {
            "selector": ".chapter-name",
            "attr": "text"
          },
          {
            "attr": "title"
          }
        ],
        "transform": "trim"
      },
      "number": {
        "or": [
          {
            "selector": ".chapter-name",
            "attr": "text"
          },
          {
            "attr": "title"
          }
        ],
        "regex": "([0-9]+(?:\\.[0-9]+)?)",
        "transform": "number"
      },
      "dateUploaded": {
        "selector": ".chapter-time",
        "attr": "text",
        "transform": "parseDate"
      }
    }
  },
  "pages": {
    "url": "{chapterUrl}",
    "itemSelector": "img.chapter-img, img[data-img]",
    "fields": {
      "imageUrl": {
        "attr": "data-img",
        "decode": "base64",
        "resolve": true
      }
    }
  }
}
