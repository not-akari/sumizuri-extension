  ],
  "catalogs": [
    {
      "id": "subscribers",
      "name": "Most subscribed",
      "url": "{baseUrl}/search/data?sort=Subscribers&order=Descending&display_mode=Full+Display&limit={pageSize}&offset={offset}"
    },
    {
      "id": "new",
      "name": "Recently added",
      "url": "{baseUrl}/search/data?sort=Recently+Added&order=Descending&display_mode=Full+Display&limit={pageSize}&offset={offset}"
    },
    {
      "id": "completed",
      "name": "Completed",
      "url": "{baseUrl}/search/data?sort=Popularity&order=Descending&included_status=Complete&display_mode=Full+Display&limit={pageSize}&offset={offset}"
    },
    {
      "id": "manhwa",
      "name": "Manhwa",
      "url": "{baseUrl}/search/data?sort=Popularity&order=Descending&included_type=Manhwa&display_mode=Full+Display&limit={pageSize}&offset={offset}"
    }
  ],
  "details": {
    "url": "{entryUrl}",
    "fields": {
      "url": {
        "template": "{entryUrl}"
      },
      "title": {
        "selector": "h1",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "picture source[type='image/webp']",
            "attr": "srcset",
            "regex": "(https?://[^\\s]+)"
          },
          {
            "selector": "img[alt*='cover']",
            "attr": "src"
          }
        ],
        "resolve": true
      },
      "bannerUrl": {
        "or": [
          {
            "selector": "picture source[type='image/webp']",
            "attr": "srcset",
            "regex": "(https?://[^\\s]+)"
          },
          {
            "selector": "img[alt*='cover']",
            "attr": "src"
          }
        ],
        "resolve": true
      },
      "description": {
        "selector": "p.whitespace-pre-wrap",
        "attr": "text",
        "transform": "trim"
      },
      "author": {
        "selector": "a[href*='/search?author=']",
        "attr": "text",
        "transform": "trim"
      },
      "status": {
        "selector": "a[href*='included_status=']",
        "attr": "text",
        "transform": "trim"
      },
      "genres": {
        "selector": "a[href*='included_tag=']",
        "attr": "text",
        "all": true,
        "transform": "trim"
      }
    }
  },
  "chapters": {
    "url": "{entryUrl}/full-chapter-list",
    "itemSelector": "a[href*='/chapters/']",
    "sort": {
      "by": "number",
      "order": "desc"
    },
    "fields": {
      "url": {
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": "span.grow span",
        "attr": "text",
        "transform": "trim"
      },
      "number": {
        "selector": "span.grow span",
        "attr": "text",
        "regex": "([0-9.]+)",
        "transform": "number"
      },
      "dateUploaded": {
        "selector": "time",
        "attr": "datetime",
        "transform": "parseDate"
      }
    }
  },
  "pages": {
    "url": "{chapterUrl}/images",
    "itemSelector": "section#chapter-images img",
    "fields": {
      "imageUrl": {
        "attr": "src",
        "resolve": true
      }
    }
  },
  "comments": {
    "url": "{baseUrl}/comments/contents/{entrySlug}?content_type=series",
    "itemSelector": "article[id^='comment-']",
    "fields": {
      "author": {
        "selector": "a[href*='/users/'] span",
        "attr": "text",
        "transform": "trim"
      },
      "text": {
        "selector": "p.whitespace-pre-wrap",
        "attr": "text",
        "transform": "trim"
      },
      "date": {
        "selector": "time.text-datetime",
        "attr": "datetime"
      },
      "avatarUrl": {
        "or": [
          {
            "selector": ".avatar picture source",
            "attr": "srcset",
            "regex": "(https?://[^\\s]+)"
          },
          {
            "selector": ".avatar img",
            "attr": "src"
          }
        ],
        "resolve": true
      }
    }
  },
  "chapterComments": {
    "url": "{baseUrl}/comments/contents/{chapterSlug}?content_type=chapter",
    "itemSelector": "article[id^='comment-']",
    "fields": {
      "author": {
        "selector": "a[href*='/users/'] span",
        "attr": "text",
        "transform": "trim"
      },
      "text": {
        "selector": "p.whitespace-pre-wrap",
        "attr": "text",
        "transform": "trim"
      },
      "date": {
        "selector": "time.text-datetime",
        "attr": "datetime"
      },
      "avatarUrl": {
        "or": [
          {
            "selector": ".avatar picture source",
            "attr": "srcset",
            "regex": "(https?://[^\\s]+)"
          },
          {
            "selector": ".avatar img",
            "attr": "src"
          }
        ],
        "resolve": true
      }
    }
  }
}
