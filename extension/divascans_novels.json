  "popular": {
    "url": "{baseUrl}/api/series?page={page}&type=NOVEL&sort=popular",
    "itemsPath": "data",
    "fields": {
      "url": {
        "template": "{baseUrl}/series/novel/{slug}"
      },
      "title": {
        "path": "title"
      },
      "coverUrl": {
        "path": "coverImage",
        "resolve": true
      },
      "rating": {
        "path": "rating"
      },
      "status": {
        "path": "status",
        "transform": "capitalize"
      }
    }
  },
  "latest": {
