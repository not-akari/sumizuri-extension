{
  "name": "Chikari",
  "lang": "en",
  "baseUrl": "https://chikari.moe",
  "iconUrl": "https://chikari.moe/icon-192.png",
  "popular": {
    "url": "{baseUrl}/api/series?sort=popular&offset={offset}&limit={pageSize}",
    "pageSize": 24,
    "itemsPath": "items",
    "fields": {
      "url": {
        "template": "/series/{slug}",
        "resolve": true
      },
      "title": {
        "path": "title"
      },
      "coverUrl": {
        "path": "cover_url"
      },
      "rating": {
        "path": "rating",
        "round": 1
      },
      "status": {
        "path": "status",
        "transform": "capitalize"
      }
    }
  },
  "latest": {
    "url": "{baseUrl}/api/series?offset={offset}&limit={pageSize}",
    "pageSize": 24,
    "itemsPath": "items",
    "fields": {
      "url": {
        "template": "/series/{slug}",
        "resolve": true
      },
      "title": {
        "path": "title"
