  "catalogs": [
    {
      "id": "new",
      "name": "Newest",
      "url": "{baseUrl}/new/page/{page}"
    },
    {
      "id": "completed",
      "name": "Completed",
      "url": "{baseUrl}/completed/page/{page}"
    },
    {
      "id": "alphabet",
      "name": "A to Z",
      "url": "{baseUrl}/search/page/{page}?q=&order=ALPHABET&genre=all"
    }
  ],
  "details": {
    "url": "{entryUrl}",
    "fields": {
      "url": {
        "template": "{entryUrl}"
      },
      "title": {
        "selector": "h1._3xnDj, h1",
        "attr": "text",
        "regex": "^([^<\\n\\r\\t]+)",
        "transform": "trim"
      },
      "coverUrl": {
        "selector": "img.manga-thumb",
        "attr": "src",
        "resolve": true
      },
      "description": {
        "or": [
          {
            "selector": "p.ZyMp7, div.ZyMp7, div.manga-description",
            "attr": "text"
          },
          {
            "selector": "meta[property=\"og:description\"]",
            "attr": "content"
          },
          {
            "selector": "meta[name=\"description\"]",
            "attr": "content"
          }
        ],
        "transform": "trim"
      },
      "author": {
        "attr": "html",
        "regex": "Author<\\/span><span>([^<]+)<\\/span>",
        "transform": "trim"
      },
      "status": {
        "attr": "html",
        "regex": "Status<\\/span><span>([^<]+)<\\/span>",
        "transform": "capitalize"
      },
      "genres": {
        "selector": "a.genre-label",
        "attr": "text",
        "all": true,
        "transform": "trim"
      }
    }
  },
  "chapters": {
    "url": "{entryUrl}",
    "itemSelector": "li.list-group-item",
    "fields": {
      "url": {
        "selector": "a._3pfyN",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": "a._3pfyN span._8Qtbo",
        "attr": "text",
        "transform": "trim"
      },
      "number": {
        "selector": "span._3D1SJ",
        "attr": "text",
        "regex": "([0-9.]+)",
        "transform": "number"
      },
      "dateUploaded": {
        "selector": "small.UovLc",
        "attr": "text",
        "transform": "parseDate"
      }
    }
  },
  "pages": {
    "url": "{chapterUrl}",
    "itemSelector": "div#mangareader img[src*='imgx.mghcdn.com'], div._2aWyJ img.PB0mN",
    "fields": {
      "imageUrl": {
        "attr": "src",
        "resolve": true
      }
    },
    "upgrade": {
      "resolve": [
        {
          "url": "{baseUrl}/",
          "cookie": "mhub_access",
          "as": "token"
        },
        {
          "from": "chapterUrl",
          "regex": "/chapter/([^/]+)/",
          "as": "mangaSlug"
        },
        {
          "from": "chapterUrl",
          "regex": "chapter-([0-9]+(?:\\.[0-9]+)?)",
          "as": "chapterNumber"
        }
      ],
      "url": "https://api.mghcdn.com/graphql",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json",
        "x-mhub-access": "{token}",
        "Origin": "https://mangahub.io"
      },
      "body": "{\"query\":\"{chapter(x:m01,slug:\\\"{mangaSlug}\\\",number:{chapterNumber}){pages}}\"}",
      "itemsRegex": "\\\\\"([^\\\\\"/]+\\.(?:jpe?g|png|webp|gif))\\\\\"",
      "fields": {
        "imageUrl": {
          "template": "https://imgx.mghcdn.com/{mangaSlug}/{chapterNumber}/{value}"
        }
      }
    }
  }
}
