{
  "name": "MangaK",
  "lang": "en",
  "baseUrl": "https://mangak.io",
  "iconUrl": "https://mangak.io/static/sites/mangak/icons/android-chrome-192x192.png",
  "rateLimitMs": 800,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Referer": "https://mangak.io/",
    "Origin": "https://mangak.io"
  },
  "popular": {
    "url": "https://api.mangak.io/trending/titles?offset={offset}&limit={pageSize}",
    "pageSize": 20,
    "itemsPath": "data.items",
    "fields": {
      "url": {
        "template": "{baseUrl}{url}"
      },
      "title": {
        "path": "name",
        "transform": "trim"
      },
      "coverUrl": {
        "path": "cover"
      },
      "rating": {
        "path": "rating"
      },
      "status": {
        "path": "status",
        "transform": "capitalize"
      }
    }
  },
  "latest": {
    "url": "https://api.mangak.io/trending/top-update?offset={offset}&limit={pageSize}",
    "pageSize": 20,
    "itemsPath": "data.items",
    "fields": {
      "url": {
        "template": "{baseUrl}{url}"
      },
      "title": {
        "path": "name",
        "transform": "trim"
      },
      "coverUrl": {
        "path": "cover"
      },
      "rating": {
        "path": "rating"
      },
      "status": {
        "path": "status",
        "transform": "capitalize"
      }
    }
  },
  "search": {
    "url": "https://api.mangak.io/titles/search?q={query}&page={page}",
    "itemsPath": "data.items",
    "fields": {
      "url": {
        "template": "{baseUrl}{url}"
      },
      "title": {
        "path": "name",
        "transform": "trim"
      },
      "coverUrl": {
        "path": "cover"
      },
      "rating": {
        "path": "rating"
      },
      "status": {
        "path": "status",
        "transform": "capitalize"
      }
    }
  },
  "catalogs": [
    {
      "id": "rising",
      "name": "Rising",
      "url": "https://api.mangak.io/trending/rising?offset={offset}&limit={pageSize}",
      "itemsPath": "data"
    }
  ],
  "details": {
    "url": "{entryUrl}",
    "fields": {
      "url": {
        "template": "{entryUrl}"
      },
      "title": {
        "or": [
          {
            "selector": "h1",
            "attr": "text"
          },
          {
            "selector": "meta[property=\"og:title\"]",
            "attr": "content"
          }
        ],
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "meta[property=\"og:image\"]",
            "attr": "content"
          }
        ],
        "resolve": true
      },
      "description": {
        "or": [
          {
            "selector": "meta[property=\"og:description\"]",
            "attr": "content"
          }
        ],
        "transform": "trim"
      },
      "genres": {
        "selector": "a[href*=\"/genres/\"]",
        "attr": "text",
        "all": true,
        "transform": "trim"
      },
      "status": {
        "selector": "meta[property=\"books:status\"], .status",
        "attr": "content",
        "transform": "capitalize",
        "default": "Ongoing"
      }
    },
    "upgrade": {
      "render": false,
      "url": "{entryUrl}",
      "jsonRegex": "<script id=\"__NEXT_DATA__\" type=\"application/json\">([\\s\\S]*?)</script>",
      "itemsPath": "props.pageProps.initialManga",
      "fields": {
        "url": {
          "template": "{entryUrl}"
        },
        "title": {
          "path": "name"
        },
        "coverUrl": {
          "path": "cover"
        },
        "description": {
          "path": "summary",
          "transform": "trim"
        },
        "author": {
          "path": "authors",
          "map": "name",
          "separator": ", "
        },
        "genres": {
          "path": "genres",
          "map": "name"
        },
        "status": {
          "path": "status",
          "transform": "capitalize"
        },
        "rating": {
          "path": "rating"
        }
      }
    }
  },
  "chapters": {
    "url": "{entryUrl}",
    "render": true,
    "itemSelector": "a[href*=\"/chapter-\"]",
    "fields": {
      "url": {
        "attr": "href",
        "resolve": true
      },
      "title": {
        "or": [
          {
            "selector": "span",
            "attr": "text"
          },
          {
            "attr": "text"
          }
        ],
        "transform": "trim"
      }
    },
    "upgrade": {
      "render": false,
      "url": "{entryUrl}",
      "jsonRegex": "<script id=\"__NEXT_DATA__\" type=\"application/json\">([\\s\\S]*?)</script>",
      "itemsPath": "props.pageProps.initialManga.chapters",
      "sort": {
        "by": "number",
        "order": "desc"
      },
      "fields": {
        "url": {
          "template": "{baseUrl}{url}"
        },
        "title": {
          "path": "name"
        },
        "number": {
          "path": "number"
        },
        "scanlator": {
          "path": "group.name"
        },
        "dateUploaded": {
          "path": "updatedAt",
          "transform": "parseDate"
        }
      }
    }
  },
  "pages": {
    "url": "{chapterUrl}",
    "render": true,
    "itemSelector": "img[src*=\"qvzr\"], img[src*=\"resmk\"], div.reader-page img, div.reading-content img",
    "fields": {
      "imageUrl": {
        "attr": "src",
        "resolve": true
      }
    },
    "upgrade": {
      "render": false,
      "url": "{chapterUrl}",
      "jsonRegex": "<script id=\"__NEXT_DATA__\" type=\"application/json\">([\\s\\S]*?)</script>",
      "itemsPath": "props.pageProps.initialChapter.images",
      "fields": {
        "imageUrl": {
          "path": ""
        }
      }
    }
  }
}
