        "or": [
          {
            "selector": "img",
            "attr": "src"
          },
          {
            "selector": "img",
            "attr": "data-src"
          },
          {
            "selector": "img",
            "attr": "data-lazy-src"
          }
        ],
        "resolve": true
      },
      "rating": {
        "selector": ".numscore",
        "attr": "text",
        "transform": "number",
        "round": 1
      }
    }
  },
  "search": {
    "url": "{baseUrl}/manga/?page={page}&title={query}",
    "itemSelector": "div.bsx",
    "fields": {
      "url": {
        "selector": "a",
        "attr": "href",
        "resolve": true
