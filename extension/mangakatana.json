{
  "name": "MangaKatana",
  "lang": "en",
  "baseUrl": "https://mangakatana.com",
  "iconUrl": "https://mangakatana.com/static/img/fav.png",
  "rateLimitMs": 1000,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Referer": "https://mangakatana.com/"
  },
  "popular": {
    "url": "{baseUrl}/manga/page/{page}",
    "itemSelector": "#book_list .item",
    "fields": {
      "url": {
        "selector": ".title a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": ".title a",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": ".wrap_img img",
            "attr": "data-src"
          },
          {
            "selector": ".wrap_img img",
            "attr": "src"
          }
        ],
        "resolve": true
      },
      "description": {
        "selector": ".summary",
        "attr": "text",
        "transform": "trim"
      },
      "status": {
        "selector": ".status",
        "attr": "text",
        "transform": "trim"
      },
      "genres": {
        "selector": ".genres a",
        "attr": "text",
        "all": true,
        "transform": "trim"
      }
    }
  },
  "latest": {
    "url": "{baseUrl}/latest/page/{page}",
    "itemSelector": "#book_list .item",
    "fields": {
      "url": {
        "selector": ".title a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": ".title a",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": ".wrap_img img",
            "attr": "data-src"
          },
          {
            "selector": ".wrap_img img",
            "attr": "src"
          }
        ],
        "resolve": true
      },
      "description": {
        "selector": ".summary",
        "attr": "text",
        "transform": "trim"
      },
      "status": {
        "selector": ".status",
        "attr": "text",
        "transform": "trim"
      },
      "genres": {
        "selector": ".genres a",
        "attr": "text",
        "all": true,
        "transform": "trim"
      }
    }
  },
  "search": {
    "url": "{baseUrl}/page/{page}?search={query}&search_by=book_name",
    "itemSelector": "#book_list .item",
    "fields": {
      "url": {
        "selector": ".title a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": ".title a",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": ".wrap_img img",
            "attr": "data-src"
          },
          {
            "selector": ".wrap_img img",
            "attr": "src"
          }
        ],
        "resolve": true
      },
      "description": {
        "selector": ".summary",
        "attr": "text",
        "transform": "trim"
      },
      "status": {
        "selector": ".status",
        "attr": "text",
        "transform": "trim"
      },
      "genres": {
        "selector": ".genres a",
        "attr": "text",
        "all": true,
        "transform": "trim"
      }
    },
    "upgrade": {
      "emptyQueryUrl": "{baseUrl}/{genre}/page/{page}"
    }
  },
