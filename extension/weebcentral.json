{
  "name": "Weeb Central",
  "lang": "en",
  "baseUrl": "https://weebcentral.com",
  "iconUrl": "https://raw.githubusercontent.com/not-akari/Sumizuri-Extension/main/docs/icons/weebcentral.png",
  "rateLimitMs": 500,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
  },
  "popular": {
    "url": "{baseUrl}/search/data?sort=Popularity&order=Descending&display_mode=Full+Display&limit={pageSize}&offset={offset}",
    "pageSize": 32,
    "itemSelector": "article.bg-base-300",
    "fields": {
      "url": {
        "selector": "a[href*='/series/']",
        "attr": "href",
        "regex": "(^.*?/series/[0-9A-Z]+)",
        "resolve": true
      },
      "title": {
        "selector": "a.link-hover[href*='/series/']",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "picture source[type='image/webp']",
            "attr": "srcset",
            "regex": "(https?://[^\\s]+)"
          },
          {
            "selector": "img[alt*='cover']",
            "attr": "src"
          }
        ],
        "resolve": true
      }
    }
  },
  "latest": {
    "url": "{baseUrl}/search/data?sort=Latest+Updates&order=Descending&display_mode=Full+Display&limit={pageSize}&offset={offset}",
    "pageSize": 32,
    "itemSelector": "article.bg-base-300",
    "fields": {
      "url": {
        "selector": "a[href*='/series/']",
        "attr": "href",
        "regex": "(^.*?/series/[0-9A-Z]+)",
        "resolve": true
      },
      "title": {
        "selector": "a.link-hover[href*='/series/']",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "picture source[type='image/webp']",
            "attr": "srcset",
            "regex": "(https?://[^\\s]+)"
          },
          {
            "selector": "img[alt*='cover']",
            "attr": "src"
          }
        ],
        "resolve": true
      }
    }
  },
  "search": {
    "url": "{baseUrl}/search/data?text={query}&display_mode=Full+Display&limit={pageSize}&offset={offset}",
    "pageSize": 32,
    "itemSelector": "article.bg-base-300",
    "fields": {
      "url": {
        "selector": "a[href*='/series/']",
        "attr": "href",
        "regex": "(^.*?/series/[0-9A-Z]+)",
        "resolve": true
      },
      "title": {
        "selector": "a.link-hover[href*='/series/']",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": "picture source[type='image/webp']",
            "attr": "srcset",
            "regex": "(https?://[^\\s]+)"
          },
          {
            "selector": "img[alt*='cover']",
            "attr": "src"
          }
        ],
        "resolve": true
      }
    },
    "upgrade": {
      "url": "{baseUrl}/search/data?text={queryPlus}&sort={sort}&order={order}{status}{type}{tag}&display_mode=Full+Display&limit={pageSize}&offset={offset}"
    }
  },
  "filters": [
    {
      "key": "sort",
      "name": "Sort by",
      "type": "select",
      "options": [
        {
          "label": "Best match",
          "value": "Best+Match"
        },
        {
          "label": "Popularity",
          "value": "Popularity"
        },
        {
          "label": "Subscribers",
          "value": "Subscribers"
        },
        {
          "label": "Latest updates",
          "value": "Latest+Updates"
        },
        {
          "label": "Recently added",
          "value": "Recently+Added"
        },
        {
          "label": "Alphabet",
          "value": "Alphabet"
        }
      ]
    },
    {
      "key": "order",
      "name": "Order",
      "type": "select",
      "options": [
        {
          "label": "Descending",
          "value": "Descending"
        },
        {
          "label": "Ascending",
          "value": "Ascending"
        }
      ]
    },
    {
      "key": "status",
      "name": "Status",
      "type": "multiSelect",
      "join": "",
      "options": [
        {
          "label": "Ongoing",
          "value": "&included_status=Ongoing"
