  "catalogs": [
    {
      "id": "new",
      "name": "New releases",
      "url": "{baseUrl}/new-release?page={page}"
    },
    {
      "id": "score",
      "name": "Top rated",
      "url": "{baseUrl}/filter?keyword=&sort=score&page={page}"
    },
    {
      "id": "airing",
      "name": "Airing now",
      "url": "{baseUrl}/filter?keyword=&sort=most-viewed&status%5B%5D=currently-airing&page={page}"
    },
    {
      "id": "movies",
      "name": "Movies",
      "url": "{baseUrl}/filter?keyword=&sort=most-viewed&term_type%5B%5D=Movie&page={page}"
    },
    {
      "id": "dub",
      "name": "Dubbed",
      "url": "{baseUrl}/filter?keyword=&sort=most-viewed&language%5B%5D=dub&page={page}"
    }
  ],
  "details": {
    "url": "{entryUrl}",
    "fields": {
      "url": {
        "template": "{entryUrl}"
      },
      "title": {
        "selector": ".title.d-title",
        "attr": "text",
        "transform": "trim"
      },
      "description": {
        "selector": ".synopsis",
        "attr": "text",
        "transform": "trim"
      },
      "genres": {
        "selector": ".meta-bl a[href*='/genre/']",
        "attr": "text",
        "all": true,
        "transform": "trim"
      },
      "webUrl": {
        "selector": ".actions a.watch",
        "attr": "href",
        "resolve": true
      }
    }
  },
  "chapters": {
    "url": "{baseUrl}/ajax/episode/list/{entrySlug}",
    "htmlPath": "*",
    "itemSelector": "li a[data-ids]",
    "fields": {
      "url": {
        "join": [
          {
            "template": "{baseUrl}/ajax/server/list?servers="
          },
          {
            "attr": "data-ids"
          }
        ],
        "separator": ""
      },
      "title": {
        "or": [
          {
            "selector": "span",
            "attr": "text",
            "transform": "trim"
          },
          {
            "selector": "b",
            "attr": "text",
            "transform": "trim"
          }
        ]
      },
      "number": {
        "attr": "data-num",
        "regex": "([0-9.]+)",
        "transform": "number"
      },
      "dateUploaded": {
        "attr": "data-timestamp",
        "regex": "([0-9]+)",
        "transform": "unixTimestamp"
      }
    }
  },
  "videos": {
    "resolve": [
      {
        "url": "{chapterUrl}",
        "headers": {
          "X-Requested-With": "XMLHttpRequest",
          "Referer": "{baseUrl}/"
        },
        "path": "result",
        "regex": "data-link-id=\"([^\"]*)\"",
        "as": "linkId"
      },
      {
        "url": "{baseUrl}/ajax/server?get={linkId}",
        "headers": {
          "X-Requested-With": "XMLHttpRequest",
          "Referer": "{baseUrl}/"
        },
        "path": "result.url",
        "as": "embedUrl"
      },
      {
        "url": "{embedUrl}",
        "headers": {
          "Referer": "{baseUrl}/"
        },
        "regex": "id=\"megaplay-player\"[^>]*data-id=\"([^\"]*)\"",
        "as": "megaId"
      }
    ],
    "url": "https://megaplay.buzz/stream/getSources?id={megaId}",
    "headers": {
      "Referer": "https://megaplay.buzz/"
    },
    "itemsPath": "",
    "fields": {
      "url": {
        "or": [
          {
            "path": "enc",
            "decode": "megaplay",
            "regex": "\"file\":\"([^\"]+)\""
          },
          {
            "join": [
              {
                "path": "tracks.0.file",
                "regex": "^(https?://[^/]+/anime/[^/]+/[^/]+)"
              },
              {
                "template": "/master.m3u8"
              }
            ],
            "separator": "",
            "requireAll": true
          }
        ]
      },
      "quality": {
        "template": "1080p (Auto)"
      }
    },
    "expandPlaylists": true,
    "videoHeaders": {
      "Referer": "https://megaplay.buzz/"
    },
    "subtitles": {
      "itemsPath": "tracks",
      "fields": {
        "url": {
          "path": "file"
        },
        "label": {
          "path": "label"
        },
        "language": {
          "path": "label",
          "transform": "lowercase"
        }
      }
    }
  }
}
