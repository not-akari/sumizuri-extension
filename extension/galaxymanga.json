  "catalogs": [
    {
      "id": "added",
      "name": "Newly added",
      "url": "{baseUrl}/manga/?page={page}&order=latest"
    },
    {
      "id": "manhua",
      "name": "Manhua",
      "url": "{baseUrl}/manga/?page={page}&order=popular&type=manhua"
    },
    {
      "id": "manga",
      "name": "Manga",
      "url": "{baseUrl}/manga/?page={page}&order=popular&type=manga"
    },
    {
      "id": "alphabet",
      "name": "A to Z",
      "url": "{baseUrl}/manga/?page={page}&order=title"
    }
  ],
  "chapters": {
    "url": "{entryUrl}",
    "itemSelector": "#chapterlist ul li",
    "sort": {
      "by": "number",
      "order": "desc"
    },
    "fields": {
      "url": {
        "selector": "a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": ".chapternum",
        "attr": "text",
        "transform": "trim"
      },
      "number": {
        "selector": ".chapternum",
        "attr": "text",
        "regex": "([0-9.]+)",
        "transform": "number"
      },
      "dateUploaded": {
        "selector": ".chapterdate",
        "attr": "text",
        "transform": "parseDate"
      }
    }
  },
  "pages": {
    "url": "{chapterUrl}",
    "jsonRegex": "ts_reader\\.run\\((\\{[\\s\\S]*?\\})\\);",
    "itemsPath": "sources.0.images",
    "fields": {
      "imageUrl": {
        "path": "",
        "resolve": true
      }
    }
  },
  "details": {
    "url": "{entryUrl}",
    "fields": {
      "url": {
        "template": "{entryUrl}"
      },
      "title": {
        "selector": "h1.entry-title",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": ".thumb img",
            "attr": "src"
          },
          {
            "selector": ".thumb img",
            "attr": "data-src"
          },
          {
            "selector": ".thumb img",
            "attr": "data-lazy-src"
          }
        ],
        "resolve": true
      },
      "bannerUrl": {
        "or": [
          {
            "selector": ".bigbanner",
            "attr": "style",
            "regex": "url\\(['\"]?([^'\")]+)['\"]?\\)"
          },
          {
            "selector": ".thumb img",
            "attr": "src"
          }
        ],
        "resolve": true
      },
      "description": {
        "selector": ".entry-content p",
        "attr": "text",
        "transform": "trim"
      },
      "rating": {
        "selector": ".rating .numscore",
        "attr": "text",
        "transform": "number",
        "round": 1
      },
      "status": {
        "selector": ".tsinfo",
        "attr": "text",
        "regex": "Status\\s+([A-Za-z]+)",
        "transform": "capitalize"
      },
      "genres": {
        "selector": ".mgen a",
        "attr": "text",
        "all": true,
        "transform": "trim"
      }
    }
  },
  "comments": {
    "url": "{entryUrl}",
    "itemSelector": "#comments .comment-body, .commentlist li",
    "fields": {
      "author": {
        "selector": ".fn, .author",
        "attr": "text",
        "transform": "trim"
      },
      "text": {
        "selector": ".comment-content, p",
        "attr": "text",
        "transform": "trim"
      },
      "avatarUrl": {
        "selector": "img.avatar",
        "attr": "src",
        "resolve": true
      },
      "date": {
        "selector": "time",
        "attr": "datetime"
      }
    }
  },
  "chapterComments": {
    "url": "{chapterUrl}",
    "itemSelector": "#comments .comment-body, .commentlist li",
    "fields": {
      "author": {
        "selector": ".fn, .author",
        "attr": "text",
        "transform": "trim"
      },
      "text": {
        "selector": ".comment-content, p",
        "attr": "text",
        "transform": "trim"
      },
      "avatarUrl": {
        "selector": "img.avatar",
        "attr": "src",
        "resolve": true
      },
      "date": {
        "selector": "time",
        "attr": "datetime"
      }
    }
  }
}
