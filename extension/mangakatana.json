  "catalogs": [
    {
      "id": "chapters",
      "name": "Most chapters",
      "url": "{baseUrl}/manga/page/{page}?filter=1&order=numc"
    },
    {
      "id": "manhwa",
      "name": "Manhwa",
      "url": "{baseUrl}/genre/manhwa/page/{page}"
    },
    {
      "id": "manhua",
      "name": "Manhua",
      "url": "{baseUrl}/genre/manhua/page/{page}"
    },
    {
      "id": "romance",
      "name": "Romance",
      "url": "{baseUrl}/genre/romance/page/{page}"
    },
    {
      "id": "action",
