{
  "name": "MangaHub",
  "lang": "en",
  "baseUrl": "https://mangahub.io",
  "iconUrl": "https://raw.githubusercontent.com/not-akari/Sumizuri-Extension/main/docs/icons/mangahub.png",
  "rateLimitMs": 1000,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Referer": "https://mangahub.io/"
  },
  "popular": {
    "url": "{baseUrl}/popular/page/{page}",
    "itemSelector": "div.media-manga",
    "fields": {
      "url": {
        "selector": "h4.media-heading a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": "h4.media-heading a",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "selector": ".media-left img",
        "attr": "src",
        "resolve": true
      },
      "author": {
        "selector": "h4.media-heading small",
        "attr": "text",
        "regex": "(?:by\\s+)?(.*)",
        "transform": "trim"
      },
      "genres": {
        "selector": "p._12-Zw a.genre-label",
        "attr": "text",
        "all": true,
        "transform": "trim"
      }
    }
  },
  "latest": {
    "url": "{baseUrl}/updates/page/{page}",
    "itemSelector": "div.media-manga",
    "fields": {
      "url": {
        "selector": "h4.media-heading a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": "h4.media-heading a",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "selector": ".media-left img",
        "attr": "src",
        "resolve": true
      },
      "author": {
        "selector": "h4.media-heading small",
        "attr": "text",
        "regex": "(?:by\\s+)?(.*)",
        "transform": "trim"
      },
      "genres": {
        "selector": "p._12-Zw a.genre-label",
        "attr": "text",
        "all": true,
        "transform": "trim"
      }
    }
  },
  "search": {
    "url": "{baseUrl}/search/page/{page}?q={query}&order=POPULAR&genre=all",
    "itemSelector": "div.media-manga",
    "fields": {
      "url": {
        "selector": "h4.media-heading a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": "h4.media-heading a",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "selector": ".media-left img",
        "attr": "src",
        "resolve": true
      },
      "author": {
        "selector": "h4.media-heading small",
        "attr": "text",
        "regex": "(?:by\\s+)?(.*)",
        "transform": "trim"
      },
      "genres": {
        "selector": "p._12-Zw a.genre-label",
        "attr": "text",
        "all": true,
        "transform": "trim"
      }
    },
    "upgrade": {
      "url": "{baseUrl}/search/page/{page}?q={query}&order={order}&genre={genre}"
    }
  },
  "filters": [
    {
      "key": "order",
      "name": "Sort by",
      "type": "select",
      "options": [
