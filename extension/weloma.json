  "popular": {
    "url": "{baseUrl}/l/0OYCn?&sort=views&page={page}",
    "itemSelector": "div.thumb-item-flow",
    "fields": {
      "url": {
        "selector": ".series-title a, a[href*=\"/m/\"]",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "or": [
          {
            "selector": ".series-title a",
            "attr": "title"
          },
          {
            "selector": ".series-title a",
            "attr": "text"
          }
        ],
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": ".img-in-ratio",
            "attr": "style",
            "regex": "url\\(['\"]?([^'\")]+)['\"]?\\)"
          },
          {
            "selector": "img",
            "attr": "src"
          }
        ],
        "resolve": true
      }
    }
  },
  "latest": {
