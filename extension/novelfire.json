  "details": {
    "url": "{entryUrl}",
    "fields": {
      "url": {
        "template": "{entryUrl}"
      },
      "title": {
        "selector": "h1.novel-title",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "selector": "figure.cover img",
        "attr": "src",
        "resolve": true
      },
      "author": {
        "selector": "span[itemprop=\"author\"]",
        "attr": "text",
        "transform": "trim"
      },
      "description": {
        "selector": "div.summary div.content",
        "attr": "html",
        "transform": "htmlToText"
      },
      "status": {
        "selector": ".header-stats strong.ongoing, .header-stats strong.completed",
        "attr": "text",
        "transform": "trim"
      },
      "rating": {
        "selector": ".main-head .rating strong.nub",
        "attr": "text",
        "transform": "number"
      },
      "genres": {
        "selector": ".categories ul li a",
        "attr": "text",
        "all": true,
        "transform": "trim"
      }
    }
  },
  "chapters": {
    "url": "{baseUrl}/book/{entrySlug}/chapters",
    "itemSelector": "ul.chapter-list li a",
    "pagination": {
      "nextSelector": "a[rel=\"next\"]",
      "maxPages": 50
    },
    "fields": {
      "url": {
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": ".chapter-title",
        "attr": "text",
        "transform": "trim"
      },
      "number": {
        "selector": ".chapter-no",
        "attr": "text",
        "transform": "number"
      },
      "dateUploaded": {
        "selector": ".chapter-update",
        "attr": "datetime"
      }
    }
  },
  "pages": {
    "url": "{chapterUrl}",
    "itemSelector": "div#content",
    "fields": {
      "text": {
        "attr": "html",
        "transform": "htmlToText"
      }
    }
  }
}
