      "url": "{baseUrl}/genre/action/page/{page}"
    },
    {
      "id": "isekai",
      "name": "Isekai",
      "url": "{baseUrl}/genre/isekai/page/{page}"
    }
  ],
  "details": {
    "url": "{entryUrl}",
    "fields": {
      "url": {
        "template": "{entryUrl}"
      },
      "title": {
        "selector": "h1.heading",
        "attr": "text",
        "transform": "trim"
      },
      "coverUrl": {
        "or": [
          {
            "selector": ".media .cover img",
            "attr": "data-src"
          },
          {
            "selector": ".media .cover img",
            "attr": "src"
          }
        ],
        "resolve": true
      },
      "description": {
        "selector": ".summary",
        "attr": "text",
        "transform": "trim"
      },
      "author": {
        "selector": ".authors a.author",
        "attr": "text",
        "transform": "trim"
      },
      "status": {
        "selector": ".value.status",
        "attr": "text",
        "transform": "trim"
      },
      "genres": {
        "selector": ".genres a",
        "attr": "text",
        "all": true,
        "transform": "trim"
      }
    }
  },
  "chapters": {
    "url": "{entryUrl}",
    "itemSelector": ".chapters table tr",
    "sort": {
      "by": "number",
      "order": "desc"
    },
    "fields": {
      "url": {
        "selector": ".chapter a",
        "attr": "href",
        "resolve": true
      },
      "title": {
        "selector": ".chapter a",
        "attr": "text",
        "transform": "trim"
      },
      "number": {
        "selector": ".chapter a",
        "attr": "text",
        "regex": "([0-9.]+)",
        "transform": "number"
      },
      "dateUploaded": {
        "selector": ".update_time",
        "attr": "text",
        "transform": "parseDate"
      }
    }
  },
  "pages": {
    "url": "{chapterUrl}",
    "render": {
      "waitFor": "#imgs .wrap_img img[data-src*='http']"
    },
    "itemSelector": "#imgs .wrap_img img",
    "fields": {
      "imageUrl": {
        "attr": "data-src",
        "resolve": true
      }
    },
    "upgrade": {
      "render": false,
      "itemsRegex": "'(https://i\\d+\\.mangakatana\\.com/token/[^']+)'",
      "fields": {
        "imageUrl": {
          "path": ""
        }
      }
    }
  }
}
